[Unit]
Description=Forward the VPN bot SOCKS socket to Germany over WireGuard
Requires=wg-quick@wg-de.service
After=wg-quick@wg-de.service

[Service]
ExecStart=/usr/lib/systemd/systemd-socket-proxyd 10.212.0.2:1080
DynamicUser=true
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
