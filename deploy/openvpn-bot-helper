#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

OPENVPN_DIR="/etc/openvpn/server"
EASYRSA_DIR="$OPENVPN_DIR/easy-rsa"
PKI_DIR="$EASYRSA_DIR/pki"
CLIENT_COMMON="$OPENVPN_DIR/client-common.txt"
LOCK_FILE="/run/lock/openvpn-bot-helper.lock"
VPN_SUBNET="10.8.0.0/24"
TRAFFIC_EVENTS_DIR="/var/lib/openvpn-bot/traffic-events"

die() {
  printf '%s\n' "$1" >&2
  exit "${2:-1}"
}

validate_installation() {
  [[ -x "$EASYRSA_DIR/easyrsa" ]] || die "Easy-RSA не найден"
  [[ -f "$CLIENT_COMMON" ]] || die "Шаблон client-common.txt не найден"
  [[ -f "$PKI_DIR/index.txt" ]] || die "Индекс PKI не найден"
}

validate_client() {
  local client="${1:-}"
  [[ "$client" =~ ^[A-Za-z0-9_-]{1,64}$ ]] || die "Некорректное имя клиента"
  [[ "$client" != "server" ]] || die "Служебный сертификат недоступен"
}

is_valid_client() {
  local client="$1"
  awk -F= -v client="$client" '$1 ~ /^V/ && $NF == client { found=1 } END { exit !found }' "$PKI_DIR/index.txt"
}

is_revoked_client() {
  local client="$1"
  awk -F= -v client="$client" '$1 ~ /^R/ && $NF == client { found=1 } END { exit !found }' "$PKI_DIR/index.txt"
}

render_client() {
  local client="$1"
  local inline="$PKI_DIR/inline/private/$client.inline"
  [[ -f "$inline" ]] || die "Данные клиента не найдены"
  grep -vh '^#' "$CLIENT_COMMON" "$inline"
}

refresh_crl() {
  local group_name
  group_name="$(stat -c '%G' "$OPENVPN_DIR/crl.pem" 2>/dev/null || true)"
  [[ -n "$group_name" ]] || group_name="nogroup"
  rm -f "$OPENVPN_DIR/crl.pem"
  cp "$PKI_DIR/crl.pem" "$OPENVPN_DIR/crl.pem"
  chown nobody:"$group_name" "$OPENVPN_DIR/crl.pem"
  chmod 0644 "$OPENVPN_DIR/crl.pem"
}

print_active_sessions() {
  local status_files=()
  local status_file

  # hwdsl2/openvpn-install uses several names depending on its version:
  # server-status.tsv, server-status-<instance>.tsv and
  # status-<instance>.log. Read every existing status file so live statistics
  # work with renamed instances such as server-tcp without changing or
  # restarting OpenVPN.
  shopt -s nullglob
  status_files=(
    /run/openvpn-server/server-status.tsv
    /run/openvpn-server/server-status-*.tsv
    /run/openvpn-server/status-*.log
    /run/openvpn/status*.log
    /var/log/openvpn/status*.log
  )
  shopt -u nullglob

  for status_file in "${status_files[@]}"; do
    [[ -r "$status_file" ]] || continue
    awk '
      {
        separator = index($0, "\t") ? "\t" : ","
        count = split($0, field, separator)
      }
      field[1] == "HEADER" && field[2] == "CLIENT_LIST" {
        for (i = 3; i <= count; i++) column[field[i]] = i - 1
        next
      }
      field[1] == "CLIENT_LIST" && column["Common Name"] &&
        column["Connected Since (time_t)"] && column["Bytes Received"] &&
        column["Bytes Sent"] {
        printf "active\t%s\t%s\t%s\t%s\n",
          field[column["Common Name"]],
          field[column["Connected Since (time_t)"]],
          field[column["Bytes Received"]],
          field[column["Bytes Sent"]]
      }
    ' "$status_file"
  done
}

cleanup_managed_server() {
  local server_key="${2:-}"
  local relay_dir="/etc/vpnbot-relay"
  local relay_unit="/etc/systemd/system/vpnbot-relay-tunnel.service"
  [[ "$server_key" =~ ^srv_[1-9][0-9]*$ ]] || die "Некорректный ключ сервера"
  # Never accept user-supplied paths or clean a shared/main OpenVPN installation.
  for path in "$OPENVPN_DIR" "$EASYRSA_DIR" "$relay_dir" "$relay_unit"; do
    [[ ! -L "$path" ]] || die "Очистка символических ссылок запрещена"
  done
  [[ -f "$relay_unit" ]] || die "Не найден управляемый relay; очистка запрещена"
  grep -Fxq 'Description=VPN bot reverse relay tunnel' "$relay_unit" || die "Чужой relay; очистка запрещена"
  grep -Fxq 'Requires=openvpn-server@server.service' "$relay_unit" || die "Чужой OpenVPN; очистка запрещена"
  if [[ -f "$relay_dir/server-key" ]]; then
    [[ "$(cat "$relay_dir/server-key")" == "$server_key" ]] || die "Ключ сервера не совпадает"
  else
    # Older bootstrap releases had no ownership marker. Accept only their exact layout.
    grep -Fxq 'local 127.0.0.1' "$OPENVPN_DIR/server.conf" || die "Не подтверждена установка ботом"
    grep -Fxq 'port 1194' "$OPENVPN_DIR/server.conf" || die "Не подтверждена установка ботом"
    grep -Eq '^proto (tcp|tcp-server)$' "$OPENVPN_DIR/server.conf" || die "Не подтверждена установка ботом"
  fi
  shopt -s nullglob
  local configs=("$OPENVPN_DIR"/*.conf)
  shopt -u nullglob
  for path in "${configs[@]}"; do
    [[ "$path" == "$OPENVPN_DIR/server.conf" ]] || die "На VPS есть другой OpenVPN; очистка запрещена"
  done
  systemctl disable --now vpnbot-relay-tunnel.service
  systemctl disable --now openvpn-server@server.service
  # Remove only this installation's VPN material; retain the OS, firewall and SSH account.
  rm -rf -- "$EASYRSA_DIR"
  rm -f -- "$OPENVPN_DIR/server.conf" "$OPENVPN_DIR/client-common.txt" \
    "$OPENVPN_DIR/ca.crt" "$OPENVPN_DIR/ca.key" "$OPENVPN_DIR/server.crt" \
    "$OPENVPN_DIR/server.key" "$OPENVPN_DIR/dh.pem" "$OPENVPN_DIR/crl.pem" \
    "$OPENVPN_DIR/tc.key" "$OPENVPN_DIR/ta.key"
  rm -f -- "$relay_unit" /usr/local/sbin/openvpn-traffic-disconnect
  rm -rf -- "$relay_dir" "$TRAFFIC_EVENTS_DIR"
  systemctl daemon-reload
  printf 'VPNBOT_CLEANUP_OK\n'
}

command="${1:-}"
case "$command" in
  cleanup)
    exec 9>"$LOCK_FILE"
    flock -w 30 9 || die "Сервер занят другой операцией"
    cleanup_managed_server "$@"
    exit 0
    ;;
  list|stats|traffic-sessions|active-sessions)
    ;;
  create|download|revoke)
    validate_client "${2:-}"
    ;;
  *)
    die "Допустимые команды: create, download, revoke, list, stats, traffic-sessions, active-sessions, cleanup"
    ;;
esac

validate_installation
exec 9>"$LOCK_FILE"
flock -w 30 9 || die "Сервер занят другой операцией"

case "$command" in
  create)
    client="$2"
    [[ ! -e "$PKI_DIR/issued/$client.crt" ]] || die "Клиент уже существует"
    cd "$EASYRSA_DIR"
    ./easyrsa --batch --days=3650 build-client-full "$client" nopass >/dev/null 2>&1
    render_client "$client"
    ;;
  download)
    client="$2"
    is_valid_client "$client" || die "Клиент не активен"
    render_client "$client"
    ;;
  revoke)
    client="$2"
    if is_revoked_client "$client"; then
      exit 0
    fi
    is_valid_client "$client" || die "Активный клиент не найден"
    cd "$EASYRSA_DIR"
    ./easyrsa --batch revoke "$client" >/dev/null 2>&1
    ./easyrsa --batch --days=3650 gen-crl >/dev/null 2>&1
    rm -f "$PKI_DIR/reqs/$client.req" "$PKI_DIR/private/$client.key"
    refresh_crl
    ;;
  list)
    awk -F= '$1 ~ /^V/ && $NF != "server" { print $NF }' "$PKI_DIR/index.txt"
    ;;
  stats)
    upload=0
    download=0
    for interface_dir in /sys/class/net/tun*; do
      [[ -d "$interface_dir/statistics" ]] || continue
      upload=$((upload + $(<"$interface_dir/statistics/rx_bytes")))
      download=$((download + $(<"$interface_dir/statistics/tx_bytes")))
    done
    printf '{"uploadBytes":%s,"downloadBytes":%s}\n' "$upload" "$download"
    ;;
  traffic-sessions)
    if [[ -d "$TRAFFIC_EVENTS_DIR" ]]; then
      find "$TRAFFIC_EVENTS_DIR" -maxdepth 1 -type f -name '*.tsv' -print0 \
        | sort -z \
        | xargs -0 -r cat
    fi
    print_active_sessions
    ;;
  active-sessions)
    print_active_sessions
    ;;
esac
