#!/usr/bin/env python3
"""OpenVPN event client. No sudo or elevation inside the OpenVPN service."""
import json
import os
import socket
import sys

event = {
    'client': os.environ.get('common_name', ''),
    'ip': os.environ.get('ifconfig_pool_remote_ip', ''),
    'connected': os.environ.get('script_type') == 'client-connect',
}
try:
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as connection:
        connection.settimeout(30)
        connection.connect('/run/vpnbot-egress-manager/session.sock')
        connection.sendall(json.dumps(event).encode() + b'\n')
        if connection.recv(32) != b'OK\n': raise RuntimeError()
except Exception:
    print('VPN egress session routing failed', file=sys.stderr)
    sys.exit(1)
